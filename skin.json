{
	"name": "SimpleText",
	"version": "2.0.0",
	"author": "Sam Wilson",
	"url": "https://www.mediawiki.org/wiki/Special:MyLangauge/Skin:SimpleText",
	"descriptionmsg": "simpletext-desc",
	"namemsg": "skinname-simpletext",
	"license-name": "GPL-3.0+",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.46.0"
	},
	"ValidSkinNames": {
		"simpletext": {
			"class": "SkinMustache",
			"args": [
				{
					"name": "simpletext",
					"responsive": true,
					"menus": [
						"associated-pages",
						"views",
						"actions",
						"variants",
						"user-page",
						"user-menu"
					],
					"styles": [
						"skins.simpletext"
					],
					"messages": [
						"sitetitle"
					]
				}
			]
		}
	},
	"MessagesDirs": {
		"SimpleText": [
			"i18n"
		]
	},
	"ResourceModules": {
		"skins.simpletext": {
			"styles": {
				"resources/libraries/normalize.css": {
					"media": "screen"
				},
				"resources/style.less": {
					"media": "all"
				},
				"resources/print.less": {
					"media": "print"
				}
			}
		}
	},
	"ResourceModuleSkinStyles": {
		"simpletext": {
			"+ext.echo.styles.badge": "resources/extensions/Echo.less"
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "SimpleText"
	},
	"manifest_version": 2
}
